# Copy to .env only when overriding defaults. Never commit real keys.
CYLEDGER_BIND=127.0.0.1
CYLEDGER_PORT=8080
CYLEDGER_ROOT_URL=http://localhost:8080/
TZ=Asia/Shanghai
# Change only when intentionally switching to another isolated data volume.
CYLEDGER_VOLUME=cyledger_data
# Optional fallback market-data key, NOT an exchange trading key.
CYLEDGER_COINGECKO_DEMO_API_KEY=
# Signing secret is generated on first start in the private persistent
# runtime/cyledger.ini. No shared default password or secret is supplied.
