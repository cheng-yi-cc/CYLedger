# syntax=docker/dockerfile:1
FROM golang:1.27.1-alpine3.24 AS backend
WORKDIR /src
RUN apk add --no-cache gcc musl-dev git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -trimpath -ldflags '-s -w -X main.Version=CYLedger-0.1.0' -o /out/cyledger ezbookkeeping.go

FROM node:26.8.1-alpine3.24 AS frontend
WORKDIR /src
RUN apk add --no-cache git
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM alpine:3.24.1
RUN apk add --no-cache ca-certificates tzdata python3 \
 && addgroup -S -g 1000 cyledger && adduser -S -D -u 1000 -G cyledger cyledger
WORKDIR /app
COPY --from=backend /out/cyledger /app/cyledger
COPY --from=frontend /src/dist /app/public
COPY conf /app/conf
COPY templates /app/templates
COPY scripts /app/scripts
COPY LICENSE /app/LICENSE
COPY NOTICE /app/NOTICE
COPY licenses /app/licenses
COPY third-party-dependencies.json /app/third-party-dependencies.json
RUN mkdir /app/runtime && chown 1000:1000 /app/runtime \
 && chmod +x /app/scripts/docker-entrypoint.sh
USER 1000:1000
ENV EBK_WORK_DIR=/app
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
 CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz.json', timeout=3).read()" || exit 1
ENTRYPOINT ["/app/scripts/docker-entrypoint.sh"]
